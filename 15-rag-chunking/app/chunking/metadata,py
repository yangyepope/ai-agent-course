from typing import Any


def build_chunk_metadata(
    source: str,
    document_title: str,
    chunk_index: int,
    **extra: Any,
) -> dict[str, Any]:

    metadata = {
        "source": source,
        "document_title": document_title,
        "chunk_index": chunk_index,
    }

    metadata.update(extra)

    return metadata


"""
使用：

metadata = build_chunk_metadata(
    source="redis.md",
    document_title="Redis 内存管理",
    chunk_index=0,
    section="maxmemory",
)

得到：

{
    "source": "redis.md",
    "document_title": "Redis 内存管理",
    "chunk_index": 0,
    "section": "maxmemory"
}

"""


